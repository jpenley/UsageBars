<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Off on purpose: UseWindowsForms swaps in its own implicit-usings set (no System.IO,
         plus System.Drawing) which collides with WPF. Explicit usings keep it unambiguous. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UsageBars</RootNamespace>
    <AssemblyName>UsageBars</AssemblyName>
    <StartupObject>UsageBars.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 tells WinForms apps to set DPI mode in code; this is a WPF app that only
         borrows WinForms for the tray icon, so the manifest is the correct place. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Portable single-file publish: no runtime install required on the target machine.
       The runtime identifier and self-contained flag are passed by build.ps1 rather than set
       here, so the test project can reference this one without inheriting a RID-specific,
       self-contained build. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Claude reports IANA time zones; Windows needs ICU to resolve those IDs correctly. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Everything is internal by design; the tests are part of the same unit. -->
  <ItemGroup>
    <InternalsVisibleTo Include="UsageBars.Tests" />
  </ItemGroup>

  <!-- winpty (libwinpty + its agent) is embedded and extracted at runtime, so driving the
       Claude Code CLI's /usage screen needs no external install. See third_party/winpty. -->
  <ItemGroup>
    <EmbeddedResource Include="..\third_party\winpty\winpty.dll" LogicalName="UsageBars.winpty.dll" />
    <EmbeddedResource Include="..\third_party\winpty\winpty-agent.exe" LogicalName="UsageBars.winpty-agent.exe" />
  </ItemGroup>

</Project>
